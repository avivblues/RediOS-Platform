@baseUrl = http://localhost:3000/api
@documentId = replace-with-runtime-document-id

### Create WORK_ORDER metadata document
POST {{baseUrl}}/runtime/WORK_ORDER
x-tenant-id: 1
x-domain-code: 1.26.1.0
x-application-code: ASSET_MAINTENANCE
x-user-id: admin
x-permissions: WORK_ORDER.CREATE,WORK_ORDER.READ,WORK_ORDER.UPDATE,WORK_ORDER.START,WORK_ORDER.COMPLETE,WORK_ORDER.CANCEL
Content-Type: application/json

{
  "data": {
    "title": "Inspect CNC machine",
    "description": "Routine inspection",
    "priority": "HIGH",
    "assignedTo": "technician-1"
  }
}

### Start WORK_ORDER through metadata workflow and process
POST {{baseUrl}}/runtime/WORK_ORDER/{{documentId}}/actions/START
x-tenant-id: 1
x-domain-code: 1.26.1.0
x-application-code: ASSET_MAINTENANCE
x-user-id: admin
x-permissions: WORK_ORDER.START
Content-Type: application/json

{}

### Complete WORK_ORDER through metadata workflow and process
POST {{baseUrl}}/runtime/WORK_ORDER/{{documentId}}/actions/COMPLETE
x-tenant-id: 1
x-domain-code: 1.26.1.0
x-application-code: ASSET_MAINTENANCE
x-user-id: admin
x-permissions: WORK_ORDER.COMPLETE
Content-Type: application/json

{}
