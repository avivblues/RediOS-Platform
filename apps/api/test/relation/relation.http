      "readonly": false
    }
  },
  {
    "tenantId": "demo",
    "domainCode": "DEFAULT",
    "applicationCode": "TEST",
    "type": "RELATION",
    "code": "SOURCE_TARGET_RELATION",
    "name": "Source Target Relation",
    "version": 1,
    "enabled": true,
    "definition": {
      "code": "SOURCE_TARGET_RELATION",
      "source": {
        "entityCode": "SOURCE"
      },
      "target": {
        "entityCode": "TARGET"
      },
      "type": "MANY_TO_ONE",
      "mapping": {
        "sourceField": "targetId",
        "targetField": "missingTargetField"
