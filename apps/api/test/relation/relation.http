    "domainCode": "DEFAULT",
    "applicationCode": "TEST",
    "type": "ENTITY",
    "code": "TARGET",
    "name": "Target",
    "version": 1,
    "enabled": true,
    "definition": {
      "code": "TARGET",
      "name": "Target",
      "type": "DOCUMENT",
      "fieldCodes": [],
      "actionCodes": [],
      "enabled": true
    }
  },
  {
