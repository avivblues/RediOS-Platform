{
  "name": "@redios/api",
  "version": "0.1.0",
  "private": true,
  "description": "RediOS Runtime Kernel API.",
  "scripts": {
    "build": "nest build",
    "start": "nest start --entryFile apps/api/src/main",
    "start:dev": "nest start --watch --entryFile apps/api/src/main",
    "seed:metadata": "nest start --entryFile apps/api/src/seed/main",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@redios/shared": "0.1.0",
    "mongoose": "^8.9.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.0"
  }
}
