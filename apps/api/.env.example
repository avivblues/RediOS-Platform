PORT=3000
MONGODB_URI=mongodb://localhost:27017/redios

# Auth (Phase 1)
# header = legacy x-* headers (dev default)
# jwt    = Bearer token required on runtime routes
AUTH_MODE=header
JWT_SECRET=redios-dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=8h
REDIOS_DEFAULT_DOMAIN_CODE=DEFAULT
REDIOS_DEFAULT_APPLICATION_CODE=ASSET_MAINTENANCE
